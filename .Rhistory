library(dplyr)
library(tidyr)
library(readr)
library(jsonlite)
# Path to the folder containing the data
folder_path <- "~/Desktop/Klicker_Session_Analyse/"
# List of session files (assuming you've got more than just Session01)
files <- list.files(folder_path, full.names = TRUE)
# Initialize an empty list to store results
result_list <- list()
# Loop through files to process the data
for (file in files) {
# Read the data (assuming it's in CSV format)
data <- read_csv(file, col_types = cols())
# Check if the 'response' column exists
if ("response" %in% colnames(data)) {
# Loop through each row and process the email and response data
for (i in 1:nrow(data)) {
email <- data$email[i]
# Check if the 'response' column contains a valid JSON string
if (!is.na(data$response[i]) && nchar(data$response[i]) > 0) {
responses <- tryCatch({
fromJSON(data$response[i])  # Parse the JSON string
}, error = function(e) {
NULL  # If JSON parsing fails, return NULL
})
# If responses exist, we process them
if (!is.null(responses)) {
# Initialize an empty vector to store question flags
question_flags <- integer(length(responses$choices))
# Check if 'choices' is a list or a vector and process accordingly
if (is.list(responses$choices)) {
# Process the choices if it's a list
for (j in 1:length(responses$choices)) {
if (!is.null(responses$choices[[j]]$value)) {
question_flags[j] <- 1
} else {
question_flags[j] <- 0
}
}
} else if (is.atomic(responses$choices)) {
# If 'choices' is atomic, handle the response as a simple vector
if (length(responses$choices) > 0) {
question_flags[1] <- 1  # Assuming one response per row, mark the first choice as answered
}
}
# Create a data frame for each question's response
result_list[[length(result_list) + 1]] <- data.frame(
email = email,
session = basename(file),
question = paste0("question_", 1:length(responses$choices)),
submitted = question_flags
)
}
}
}
} else {
# If the 'response' column is not found, print a warning
warning(paste("No 'response' column in file:", file))
}
}
# Combine all session data into a final data frame
