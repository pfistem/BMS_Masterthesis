email <- data$email[i]
# Check if the 'response' column contains a valid JSON string
if (!is.na(data$response[i]) && nchar(data$response[i]) > 0) {
responses <- tryCatch({
fromJSON(data$response[i])  # Parse the JSON string
}, error = function(e) {
NULL  # If JSON parsing fails, return NULL
})
# Create a submission flag (1 if there are choices or values)
submitted_flag <- ifelse(!is.null(responses) && (length(responses$choices) > 0 | !is.null(responses$value)), 1, 0)
# Append to the result list
result_list[[length(result_list) + 1]] <- data.frame(email = email, session = basename(file), submitted = submitted_flag)
}
}
} else {
# If the 'response' column is not found, print a warning
warning(paste("No 'response' column in file:", file))
}
}
# Combine all session data
final_data <- bind_rows(result_list)
# Aggregating the data to ensure unique combinations of email and session
final_data_agg <- final_data %>%
group_by(email, session) %>%
summarise(submitted = max(submitted), .groups = "drop")
# Pivot the data to create one row per email and one column per session
result_table <- final_data_agg %>%
spread(key = session, value = submitted, fill = 0)
# Add a column for total participations
result_table <- result_table %>%
mutate(total_participations = rowSums(select(., -email)))
# Create LaTeX output for the table in landscape format
latex_code <- "
\\documentclass{article}
\\usepackage{geometry}
\\usepackage{longtable}
\\usepackage{lscape}
\\geometry{landscape}
\\begin{document}
\\begin{landscape}
\\begin{longtable}{|l|"
# Dynamically add columns for each session
latex_code <- paste(latex_code, paste(rep("|c", length(files)), collapse = ""), "|} \\hline")
latex_code <- paste(latex_code, "\\textbf{Email} & ", paste(sprintf("\\textbf{Session %d}", 1:length(files)), collapse = " & "), " & \\textbf{Total Participations} \\\\ \\hline \\endfirsthead", sep = "")
# Add rows with data
for (i in 1:nrow(result_table)) {
latex_code <- paste(latex_code, result_table$email[i], " & ", paste(result_table[i, -1], collapse = " & "), " & ", result_table$total_participations[i], "\\\\ \\hline", sep = "")
}
# Finalize LaTeX document
latex_code <- paste(latex_code, "\\end{longtable}\\end{landscape}\\end{document}", sep = "")
# Write LaTeX code to a .tex file
writeLines(latex_code, "klicker_results_landscape.tex")
# Print a message
cat("LaTeX file created: klicker_results_landscape.tex\n")
latex_code
